<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Some BD news feeds use certificates or configurations that may not
         validate on all devices. Allow cleartext and trust system CAs plus
         the broader set so headline fetching works across networks. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
