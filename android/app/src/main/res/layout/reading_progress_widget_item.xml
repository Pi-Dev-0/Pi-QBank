<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="84dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reading_widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reading_widget_item_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#4B5563"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1">

                <ProgressBar
                    android:id="@+id/reading_widget_item_progress_early"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="center_vertical"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#EF6C57"
                    android:progressBackgroundTint="#F5E9E6" />

                <ProgressBar
                    android:id="@+id/reading_widget_item_progress_mid"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="center_vertical"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#F2A43A"
                    android:progressBackgroundTint="#F5EFE5"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/reading_widget_item_progress_late"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="center_vertical"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#5388E8"
                    android:progressBackgroundTint="#E7EDF8"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/reading_widget_item_progress_done"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="center_vertical"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#27A27B"
                    android:progressBackgroundTint="#E5F1EC"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/reading_widget_item_percent"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#6D28D9"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/reading_widget_item_minus"
        android:layout_width="36dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/reading_progress_widget_button"
        android:gravity="center"
        android:text="−1"
        android:textColor="#4C1D95"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/reading_widget_item_plus"
        android:layout_width="36dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/reading_progress_widget_button"
        android:gravity="center"
        android:text="+1"
        android:textColor="#4C1D95"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/reading_widget_item_plus_five"
        android:layout_width="36dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/reading_progress_widget_button"
        android:gravity="center"
        android:text="+5"
        android:textColor="#4C1D95"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
