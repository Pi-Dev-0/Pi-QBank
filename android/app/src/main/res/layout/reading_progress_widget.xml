<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reading_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reading_progress_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/reading_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="Reading Progress"
        android:textColor="#1F2937"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/reading_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E5E7EB"
        android:dividerHeight="1dp"
        android:scrollbars="vertical"
        android:cacheColorHint="#00000000" />

    <TextView
        android:id="@+id/reading_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="Add books in Pi-QBank to track them here."
        android:textColor="#4B5563"
        android:textSize="14sp" />
</LinearLayout>
