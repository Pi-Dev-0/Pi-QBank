<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:layout_marginBottom="7dp"
    android:background="@drawable/study_widget_item_background"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="9dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="4dp"
        android:layout_height="34dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/study_widget_item_accent"
        android:importantForAccessibility="no"
        android:text="" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/study_widget_item_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Subject"
            android:textColor="#25213A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/study_widget_item_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Mon · 9:00 AM – 10:00 AM"
            android:layout_marginTop="3dp"
            android:textColor="#68657A"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/study_widget_item_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/study_widget_status_active"
        android:paddingStart="7dp"
        android:paddingTop="3dp"
        android:paddingEnd="7dp"
        android:paddingBottom="3dp"
        android:text="NOW"
        android:textColor="#28745D"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
